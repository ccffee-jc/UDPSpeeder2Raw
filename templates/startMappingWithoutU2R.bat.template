@echo off
setlocal enabledelayedexpansion

echo Starting UDPSpeeder in direct mode...
echo Note Direct connection UDPSpeeder to Remote Server
echo.

rem Check if REMOTE_HOST is a domain name and resolve it to IP
set REMOTE_HOST={{REMOTE_HOST}}
echo Checking remote host !REMOTE_HOST!

rem Try to resolve domain name to IP using PowerShell
for /f %%i in ('powershell -Command "[System.Net.Dns]::GetHostAddresses('!REMOTE_HOST!') | Select-Object -First 1 | ForEach-Object { $_.IPAddressToString }" 2^>nul') do (
    set RESOLVED_IP=%%i
)

rem If we got a resolved IP use it otherwise use the original value
if defined RESOLVED_IP (
    echo Domain !REMOTE_HOST! resolved to IP !RESOLVED_IP!
    set REMOTE_HOST=!RESOLVED_IP!
) else (
    echo Using original host value may be IP !REMOTE_HOST!
)

echo Starting UDPSpeeder...
start "UDPSpeeder Client" "%~dp0speederv2.exe" -c -l 0.0.0.0:51820 -r !REMOTE_HOST!:{{SPEEDER_PORT}} -k {{PASSWORD}} -f{{FEC_CONFIG}} --mode {{MODE}} --timeout {{TIMEOUT}} -q {{QUEUE}} -i {{INTERVAL}}

echo Services started in direct configuration
echo Architecture WireGuard 51820 to UDPSpeeder to Remote Server Direct
echo UDPSpeeder listening on 0.0.0.0 port 51820 WireGuard port
echo UDPSpeeder forwarding directly to !REMOTE_HOST! port {{SPEEDER_PORT}}
pause
